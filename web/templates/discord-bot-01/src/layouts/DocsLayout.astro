
---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import DocsSidebar from '../components/documentation/DocsSidebar.astro';

interface Props {
  title: string;
  description: string;
  section: 'getting-started' | 'documentation';
}

const { title, description, section } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="docs-shell">
    <div class="container docs-container">
      <DocsSidebar section={section} />

      <div class="docs-main">
        <nav class="docs-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>
            {section === 'getting-started'
              ? 'Getting Started'
              : 'Documentation'}
          </span>
        </nav>

        <header class="docs-page-header">
          <p class="docs-eyebrow">
            {section === 'getting-started'
              ? 'GETTING STARTED'
              : 'DOCUMENTATION'}
          </p>

          <h1>{title}</h1>
          <p>{description}</p>
        </header>

        <div class="docs-content">
          <slot />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-shell {
    min-height: 70vh;
    padding: var(--space-12) 0 var(--space-16);
  }

  .docs-container {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-12);
  }

  .docs-main {
    min-width: 0;
    max-width: 860px;
  }

  .docs-eyebrow {
    color: var(--color-violet);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
  }

  .docs-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .docs-breadcrumb a:hover {
    color: var(--color-text-primary);
  }

  .docs-page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .docs-page-header h1 {
    margin-top: var(--space-3);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: var(--line-height-tight);
  }

  .docs-page-header > p:last-child {
    max-width: 680px;
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .docs-content {
    padding-top: var(--space-8);
  }

  @media (max-width: 900px) {
    .docs-container {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 700px) {
    .docs-container {
      grid-template-columns: 1fr;
    }

    .docs-main {
      max-width: none;
    }
  }
</style>
