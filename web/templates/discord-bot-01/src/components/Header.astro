---
import Logo from './Logo.astro';
import Button from './Button.astro';

const navigation = [
  { label: 'Features', href: '/features/' },
  { label: 'Commands', href: '/commands/' },
  { label: 'Documentation', href: '/docs/' },
  { label: 'FAQ', href: '/faq/' },
];
---

<header class="site-header">
  <div class="header-container container">
    <Logo size="medium" />

    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav
      class="primary-navigation"
      id="primary-navigation"
      aria-label="Primary navigation"
      data-navigation
    >
      <ul class="navigation-list">
        {navigation.map((item) => (
          <li>
            <a class="navigation-link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="header-actions">
        <Button href="/features/" variant="primary">
          Explore Features
        </Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    width: 100%;
    background: rgb(11 16 32 / 90%);
    border-bottom: 1px solid var(--color-border-subtle);
    backdrop-filter: blur(16px);
  }

  .header-container {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .primary-navigation {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .navigation-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .navigation-link {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .navigation-link:hover,
  .navigation-link[aria-current='page'] {
    color: var(--color-text-primary);
  }

  .mobile-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-deep-slate);
  }

  .mobile-menu-toggle span {
    width: 18px;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
  }

  @media (max-width: 48rem) {
    .mobile-menu-toggle {
      display: flex;
    }

    .primary-navigation {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
      padding: var(--space-6) 1.25rem;
      background: var(--color-deep-slate);
      border-bottom: 1px solid var(--color-border);
    }

    .primary-navigation[data-open='true'] {
      display: flex;
    }

    .navigation-list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }

    .navigation-link {
      display: block;
      padding: var(--space-2) 0;
    }

    .header-actions,
    .header-actions .button {
      width: 100%;
    }
  }
</style>