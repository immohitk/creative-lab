
---
interface Props {
  type?: 'info' | 'success' | 'warning' | 'concept';
  title?: string;
}

const {
  type = 'info',
  title,
} = Astro.props;

const defaultTitles = {
  info: 'Information',
  success: 'Good to know',
  warning: 'Important',
  concept: 'Concept demonstration',
};

const calloutTitle = title ?? defaultTitles[type];
---

<aside
  class:list={['docs-callout', `docs-callout-${type}`]}
  aria-label={calloutTitle}
>
  <div class="docs-callout-indicator" aria-hidden="true">
    {type === 'info' && 'i'}
    {type === 'success' && '+'}
    {type === 'warning' && '!'}
    {type === 'concept' && '*'}
  </div>

  <div class="docs-callout-content">
    <h3>{calloutTitle}</h3>
    <div class="docs-callout-message">
      <slot />
    </div>
  </div>
</aside>

<style>
  .docs-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-6) 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--color-blue);
    border-radius: var(--radius-lg);
    background: var(--color-deep-slate);
  }

  .docs-callout-indicator {
    display: grid;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    place-items: center;
    border-radius: var(--radius-full);
    background: rgb(59 130 246 / 15%);
    color: var(--color-blue);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
  }

  .docs-callout-content {
    min-width: 0;
  }

  .docs-callout-content h3 {
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .docs-callout-message {
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .docs-callout-success {
    border-left-color: var(--color-success);
  }

  .docs-callout-success .docs-callout-indicator {
    background: rgb(34 197 94 / 15%);
    color: var(--color-success);
  }

  .docs-callout-warning {
    border-left-color: var(--color-warning);
  }

  .docs-callout-warning .docs-callout-indicator {
    background: rgb(245 158 11 / 15%);
    color: var(--color-warning);
  }

  .docs-callout-concept {
    border-left-color: var(--color-violet);
  }

  .docs-callout-concept .docs-callout-indicator {
    background: rgb(139 92 246 / 15%);
    color: var(--color-violet);
  }
</style>
