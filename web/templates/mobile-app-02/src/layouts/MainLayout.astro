
---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mobile App — Go Beyond",
  description = "Discover a bold new mobile app experience."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101318" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
