{
  "name": "creative-lab-floating-clock-c03",
  "version": "1.1.0",
  "private": true,
  "description": "Creative Lab Floating Clock - customizable Windows desktop widget",
  "author": "Creative Lab by Mohit Kumar",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.creativelab.floatingclock.c03",
    "productName": "Creative Lab Floating Clock",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "src/**/*", "assets/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "engines": { "node": ">=24 <25", "npm": ">=11" }
}